# Supabase Configuration
# Get these from your Supabase project: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini API Configuration (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# Default recommended model: gemini-2.5-flash (also supports gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google Fact Check Tools API Configuration (Server-Side Only)
# Enable "Fact Check Tools API" in Google Cloud Console & generate an API key
# Reference: https://developers.google.com/fact-check/tools/api/reference/rest/v1alpha1/claims/search
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-api-key-here
