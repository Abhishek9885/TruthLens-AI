# ============================================================================
# TruthLens AI — Environment Configuration Template
# ============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit actual secrets, API keys, or service-role keys to version control.
# ============================================================================

# --- Supabase Configuration (Required) ---
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional Server-Only Supabase Service Role Key (NEVER expose to client)
# Used for background maintenance scripts and initial admin provisioning
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# --- Google Gemini AI (Required for Claim Extraction & Verification Reasoning) ---
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
# Kept strictly server-side (never use NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Google Fact Check Tools API (Required for Fact-Check Evidence Retrieval) ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create API Key
# Enable "Fact Check Tools API" in your Google Cloud Project.
# Kept strictly server-side (never use NEXT_PUBLIC_ prefix)
GOOGLE_FACTCHECK_API_KEY=AIzaSyYourFactCheckApiKeyHere

# --- Application URL (Required for Auth Callbacks & Redirects) ---
# Local development default:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production on Vercel:
# NEXT_PUBLIC_APP_URL=https://truthlens-ai.vercel.app
